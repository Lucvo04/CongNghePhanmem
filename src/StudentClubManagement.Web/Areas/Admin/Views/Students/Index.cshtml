@model StudentClubManagement.Web.ViewModels.Admin.StudentListViewModel
@using StudentClubManagement.Web.Models
@{
    ViewData["Title"] = "Tài khoản sinh viên";
}
<section class="container py-5">
    <a class="d-inline-block mb-4" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">← Khu vực quản trị</a>
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <p class="eyebrow">Quản lý người dùng</p>
            <h1 class="h2">Tài khoản sinh viên</h1>
            <p class="text-secondary mb-0">Duyệt hồ sơ tự đăng ký và quản lý trạng thái tài khoản sinh viên.</p>
        </div>
        <a class="btn btn-primary px-4 py-2 flex-shrink-0" asp-action="Index" asp-route-status="3">Đăng ký chờ duyệt</a>
    </div>
    @if (TempData["StatusMessage"] is string message)
    {
        <div class="alert alert-success" role="status">@message</div>
    }
    <form asp-action="Index" method="get" class="card community-card p-4 mb-4">
        <div class="row g-3 align-items-end">
            <div class="col-lg-6">
                <label for="search" class="form-label fw-semibold">Tìm sinh viên</label>
                <input id="search" name="search" value="@Model.Search" class="form-control" maxlength="256" placeholder="Họ tên, mã sinh viên hoặc email" />
            </div>
            <div class="col-sm-6 col-lg-3">
                <label for="status" class="form-label fw-semibold">Trạng thái tài khoản</label>
                <select id="status" name="status" class="form-select" asp-for="Status">
                    <option value="">Tất cả trạng thái</option>
                    <option value="1">Đang hoạt động</option>
                    <option value="2">Đã khóa</option><option value="3">Chờ duyệt</option><option value="4">Đã từ chối</option>
                </select>
            </div>
            <div class="col-sm-6 col-lg-3 d-flex gap-2">
                <button class="btn btn-primary" type="submit">Tìm kiếm</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Bỏ lọc</a>
            </div>
        </div>
    </form>
    <p class="small text-secondary">@Model.TotalCount tài khoản phù hợp · Trang @Model.Page / @Model.TotalPages</p>
    @if (Model.Students.Count == 0)
    {
        <div class="card community-card p-4 p-md-5 text-center">
            <h2 class="h4">Chưa có tài khoản phù hợp</h2>
            <p class="text-secondary mb-0">Sinh viên tự gửi đăng ký từ trang Đăng nhập. Bạn có thể chọn bộ lọc Chờ duyệt để xử lý hồ sơ mới.</p>
        </div>
    }
    else
    {
        <div class="card community-card overflow-hidden">
            <div class="table-responsive">
                <table class="table align-middle mb-0 student-table">
                    <caption class="visually-hidden">Danh sách tài khoản sinh viên</caption>
                    <thead><tr><th scope="col">Sinh viên</th><th scope="col">Email</th><th scope="col">Lớp / Khoa</th><th scope="col">Trạng thái</th><th scope="col">Thao tác</th></tr></thead>
                    <tbody>
                    @foreach (var student in Model.Students)
                    {
                        <tr data-student-id="@student.Id">
                            <td><strong class="d-block text-break">@student.FullName</strong><span class="text-secondary">@student.StudentCode</span></td>
                            <td class="text-break">@student.Email</td>
                            <td><span class="d-block text-break">@(student.ClassName ?? "Chưa có lớp")</span><span class="small text-secondary text-break">@(student.Faculty ?? "Chưa có khoa")</span></td>
                            <td><span class="badge @(student.Status == UserStatus.Active ? "text-bg-success" : "text-bg-secondary")">@student.Status.Label()</span></td>
                            <td>@if (student.Status is UserStatus.Pending or UserStatus.Rejected) { <a class="btn btn-sm btn-primary" asp-action="Review" asp-route-id="@student.Id">@(student.Status == UserStatus.Pending ? "Duyệt đăng ký" : "Xem hồ sơ")</a> } else { <a class="btn btn-sm btn-outline-secondary text-nowrap" asp-action="ChangeStatus" asp-route-id="@student.Id" aria-label="@(student.Status == UserStatus.Active ? "Khóa tài khoản " : "Mở khóa tài khoản ")@student.StudentCode">@(student.Status == UserStatus.Active ? "Khóa" : "Mở khóa")</a> }</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
    @if (Model.TotalPages > 1)
    {
        <nav class="d-flex align-items-center justify-content-end gap-3 mt-4" aria-label="Phân trang sinh viên">
            @if (Model.Page > 1)
            {
                <a class="btn btn-outline-secondary" asp-action="Index" asp-route-search="@Model.Search" asp-route-status="@((int?)Model.Status)" asp-route-page="@(Model.Page - 1)">Trang trước</a>
            }
            <span aria-current="page">@Model.Page / @Model.TotalPages</span>
            @if (Model.Page < Model.TotalPages)
            {
                <a class="btn btn-outline-secondary" asp-action="Index" asp-route-search="@Model.Search" asp-route-status="@((int?)Model.Status)" asp-route-page="@(Model.Page + 1)">Trang sau</a>
            }
        </nav>
    }
</section>
