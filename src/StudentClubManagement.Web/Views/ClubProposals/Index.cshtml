@model StudentClubManagement.Web.ViewModels.Clubs.ClubProposalList
@{ ViewData["Title"] = Model.IsAdmin ? "Duyệt thành lập CLB" : "Đơn thành lập của tôi"; }
<section class="container py-5"><div class="d-flex flex-wrap gap-3 justify-content-between align-items-center mb-4"><div><p class="eyebrow">Ý tưởng thành cộng đồng</p><h1 class="h2">@ViewData["Title"]</h1></div>@if (!Model.IsAdmin) { <a class="btn btn-primary" asp-action="Create">Đề nghị thành lập CLB</a> }</div>
<form method="get" asp-action="Index" class="card community-card p-4 mb-4"><label for="proposal-status" class="form-label">Trạng thái đơn</label><div class="d-flex gap-3"><select id="proposal-status" name="status" class="form-select"><option value="">Tất cả trạng thái</option>@foreach(var status in Enum.GetValues<ProposalStatus>()) { <option value="@((int)status)" selected="@(Model.Status == status)">@status.Label()</option> }</select><button class="btn btn-primary">Lọc</button></div></form>
<p>@Model.Count đơn · Trang @Model.Page / @Model.Pages</p>
@if (Model.Items.Count == 0) { <p class="card community-card p-4">Chưa có đơn phù hợp.</p> }
<div class="row g-4">@foreach (var item in Model.Items) { <div class="col-md-6"><article class="card community-card h-100 p-4"><span class="small text-secondary">@item.Status.Label() · @item.SubmittedAt.Vietnam()</span><h2 class="h4 text-break mt-2">@item.Name</h2>@if(Model.IsAdmin) { <p class="text-break">Người gửi: @item.Applicant.FullName · @item.Applicant.StudentCode</p> }<a class="btn btn-outline-primary mt-auto" asp-action="Details" asp-route-id="@item.Id">Xem đơn</a></article></div> }</div>
@if(Model.Pages > 1) { <nav class="d-flex gap-3 mt-4" aria-label="Phân trang đơn thành lập">@if(Model.Page > 1) { <a asp-action="Index" asp-route-status="@Model.Status" asp-route-page="@(Model.Page-1)">Trang trước</a> }@if(Model.Page < Model.Pages) { <a asp-action="Index" asp-route-status="@Model.Status" asp-route-page="@(Model.Page+1)">Trang sau</a> }</nav> }
</section>
