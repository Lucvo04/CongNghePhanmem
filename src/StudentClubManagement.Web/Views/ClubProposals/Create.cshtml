@model StudentClubManagement.Web.ViewModels.Clubs.ClubProposalForm
@{ ViewData["Title"] = "Đề nghị thành lập CLB"; }
<section class="container py-5"><a asp-action="Index">← Đơn thành lập của tôi</a><div class="account-details mt-4"><p class="eyebrow">Bắt đầu một cộng đồng</p><h1 class="h2">Đề nghị thành lập CLB</h1><div class="card community-card p-4 mt-4"><p>Hãy trình bày mục đích và kế hoạch của CLB. Khi Admin chấp nhận, bạn sẽ là chủ nhiệm đầu tiên. Mỗi sinh viên có tối đa một đơn đang chờ.</p>
<div asp-validation-summary="All" class="text-danger" role="alert"></div><form asp-action="Create" method="post"><div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" maxlength="150" /></div><div class="mb-3"><label asp-for="Category" class="form-label"></label><input asp-for="Category" class="form-control" maxlength="100" /></div><div class="mb-3"><label asp-for="Purpose" class="form-label"></label><textarea asp-for="Purpose" class="form-control" rows="7" maxlength="2000"></textarea></div><button class="btn btn-primary">Gửi đơn thành lập</button></form></div></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
