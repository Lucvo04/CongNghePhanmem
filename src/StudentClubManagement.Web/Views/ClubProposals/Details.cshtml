@model StudentClubManagement.Web.ViewModels.Clubs.ClubProposalDecision
@{ ViewData["Title"] = "Đơn thành lập CLB"; var item = Model.Item; }
<section class="container py-5"><a asp-action="Index" asp-route-status="">← Danh sách đơn</a><h1 class="h2 mt-4 text-break">@item.Name</h1>
@if(TempData["ProposalMessage"] is string message) { <div class="alert alert-success" role="status">@message</div> }
<div class="card community-card p-4 mt-4"><p><strong>@item.Status.Label()</strong> · @item.SubmittedAt.Vietnam()</p><p class="text-break">Người gửi: @item.Applicant.FullName · @item.Applicant.StudentCode</p><p class="text-break">Lĩnh vực: @(item.Category ?? "Chưa phân loại")</p><h2 class="h5">Mục đích và kế hoạch</h2><p class="club-description text-break">@item.Purpose</p>
@if(item.ClubId.HasValue) { <a class="btn btn-outline-primary" asp-controller="Clubs" asp-action="Details" asp-route-id="@item.ClubId">Xem CLB đã thành lập</a> }
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
@if(item.Status == ProposalStatus.Pending) { <form asp-action="Decide" asp-route-id="@item.Id" method="post" class="mt-4"><input asp-for="RowVersion" type="hidden" />
@if(Model.IsAdmin) { <label for="operation" class="form-label">Quyết định</label><select id="operation" asp-for="Operation" class="form-select mb-3"><option value="">Chọn quyết định</option><option value="Approve">Chấp nhận và thành lập CLB</option><option value="Reject">Từ chối</option></select><label asp-for="Code" class="form-label"></label><input asp-for="Code" maxlength="30" class="form-control mb-3" /><p class="small text-secondary">Chấp nhận sẽ tạo CLB đang hoạt động và phân công người gửi làm chủ nhiệm. Mã chỉ dùng khi chấp nhận.</p><label asp-for="Reason" class="form-label"></label><textarea asp-for="Reason" rows="3" maxlength="500" class="form-control mb-3"></textarea><p class="small text-secondary">Từ chối cần lý do; người gửi xem được lý do trong lịch sử.</p><button class="btn btn-primary">Lưu quyết định</button> }
else { <input name="Operation" value="Withdraw" type="hidden" /><p>Bạn có thể rút đơn đang chờ để chỉnh lại kế hoạch rồi nộp đơn mới.</p><button class="btn btn-outline-danger">Rút đơn thành lập</button> }
<a class="btn btn-link" asp-action="Details" asp-route-id="@item.Id">Tải lại</a></form> }</div>
<section class="card community-card p-4 mt-4"><h2 class="h5">Lịch sử xử lý</h2><ol>@foreach(var log in Model.History) { var label = log.Action switch { "ClubProposalSubmitted" => "Gửi đơn", "ClubProposalApproved" => "Chấp nhận", "ClubProposalRejected" => "Từ chối", _ => "Rút đơn" }; <li class="mb-2 text-break">@label · @log.Actor · @log.At.Vietnam() @if(log.Reason is not null) { <p class="mb-0">@log.Reason</p> }</li> }</ol></section></section>
