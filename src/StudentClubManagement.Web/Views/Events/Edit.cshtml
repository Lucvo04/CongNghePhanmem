@model StudentClubManagement.Web.ViewModels.Events.EventForm
@{ ViewData["Title"] = Model.Id.HasValue ? "Sửa hoạt động" : "Tạo hoạt động"; }
<section class="container py-5">
    <a asp-action="Index" asp-route-clubId="@Model.Club.Id">← Quản lý hoạt động</a>
    <div class="account-details mt-4"><p class="eyebrow">@Model.Club.Name</p><h1 class="h2">@ViewData["Title"]</h1>
    <div class="card community-card p-4 p-md-5 mt-4">
        <p>Thời gian nhập theo giờ Việt Nam (UTC+7). Hoạt động mới được lưu dưới dạng bản nháp để kiểm tra trước khi công bố.</p>
        @if (Model.IsPublished) { <p class="alert alert-info">Khi đổi thời gian, hạn đăng ký hoặc địa điểm, người còn đăng ký sẽ tự nhận thông báo về thay đổi và lý do bạn nhập.</p> }
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <form asp-action="@(Model.Id.HasValue ? "Edit" : "Create")" asp-route-id="@Model.Id" asp-route-clubId="@Model.Club.Id" method="post">
            <input asp-for="RowVersion" type="hidden" />
            <div class="mb-3"><label asp-for="Title" class="form-label"></label><input asp-for="Title" maxlength="180" class="form-control" /></div>
            <div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" maxlength="4000" rows="5" class="form-control"></textarea></div>
            <div class="mb-3"><label asp-for="Location" class="form-label"></label><input asp-for="Location" maxlength="250" class="form-control" /></div>
            <div class="row g-3 mb-3"><div class="col-md-6"><label asp-for="StartsAt" class="form-label"></label><input asp-for="StartsAt" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local" class="form-control" /></div><div class="col-md-6"><label asp-for="EndsAt" class="form-label"></label><input asp-for="EndsAt" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local" class="form-control" /></div></div>
            <div class="mb-3"><label asp-for="RegistrationDeadline" class="form-label"></label><input asp-for="RegistrationDeadline" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local" class="form-control" /><small>Hạn đăng ký không được sau thời gian bắt đầu.</small></div>
            <div class="row g-3 mb-3"><div class="col-md-6"><label asp-for="Capacity" class="form-label"></label><input asp-for="Capacity" type="number" min="1" class="form-control" /></div><div class="col-md-6"><label asp-for="Audience" class="form-label"></label><select asp-for="Audience" class="form-select" disabled="@Model.IsPublished"><option value="1">Toàn trường</option><option value="2">Nội bộ CLB</option></select>@if (Model.IsPublished) { <input asp-for="Audience" type="hidden" /><small>Đối tượng được giữ nguyên sau công bố.</small> }</div></div>
            @if (Model.IsPublished) { <div class="mb-3"><label asp-for="Reason" class="form-label"></label><textarea asp-for="Reason" maxlength="500" required rows="3" class="form-control"></textarea></div> }
            <div class="d-flex flex-wrap gap-2 mt-4"><button class="btn btn-primary" type="submit">@(Model.Id.HasValue ? "Lưu thay đổi" : "Lưu bản nháp")</button><a class="btn btn-outline-secondary" asp-action="Index" asp-route-clubId="@Model.Club.Id">Quay lại</a>@if (Model.Id.HasValue) { <a class="btn btn-link" asp-action="Edit" asp-route-id="@Model.Id">Tải lại</a> }</div>
        </form>
    </div></div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
