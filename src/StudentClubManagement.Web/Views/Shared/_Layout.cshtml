@inject StudentClubManagement.Web.Services.AnnouncementService Announcements
@using System.Security.Claims
@using StudentClubManagement.Web.Security
@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var student = User.IsInRole(SystemRoles.Student);
    var unread = signedIn && student ? await Announcements.UnreadCountAsync(User.FindFirstValue(ClaimTypes.NameIdentifier)!) : 0;
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="VinhUni Clubs — Khám phá câu lạc bộ, kết nối đam mê và tìm hiểu đời sống sinh viên Trường Đại học Vinh. Website đồ án học phần." />
    <title>@ViewData["Title"] | VinhUni Clubs</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Chuyển đến nội dung chính</a>
    <div class="university-strip"><div class="container"><span>TRƯỜNG ĐẠI HỌC VINH <span class="d-none d-md-inline">· CỘNG ĐỒNG SINH VIÊN</span></span><a href="https://vinhuni.edu.vn/pages/" target="_blank" rel="noopener noreferrer">Cổng thông tin trường ↗</a></div></div>
    <header class="site-header">
        <div class="container site-header-inner">
            <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                <img src="~/images/vinh/logo.png" width="52" height="52" alt="Biểu trưng Trường Đại học Vinh" />
                <span class="brand-wordmark">VinhUni <span>Clubs</span><small>CÂU LẠC BỘ SINH VIÊN</small></span>
            </a>
            <nav class="site-primary-navigation" aria-label="Điều hướng chính" id="main-navigation">
                <ul class="site-primary-links">
                    <li><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index" aria-current="@(controller == "Home" && action == "Index" ? "page" : null)">Trang chủ</a></li>
                    <li><a class="nav-link" asp-area="" asp-controller="Clubs" asp-action="Index" aria-current="@(controller == "Clubs" ? "page" : null)">Câu lạc bộ</a></li>
                    <li><a class="nav-link" asp-area="" asp-controller="Events" asp-action="Calendar" aria-current="@(controller == "Events" && action == "Calendar" ? "page" : null)">Lịch hoạt động</a></li>
                    <li><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="gioi-thieu">Giới thiệu</a></li>
                </ul>
            </nav>
            @if (signedIn)
            {
                <button class="btn personal-menu-toggle" type="button" data-bs-toggle="offcanvas" data-bs-target="#personal-menu"
                        aria-controls="personal-menu" aria-expanded="false" aria-label="Mở menu cá nhân@(unread > 0 ? $", {unread} thông báo chưa đọc" : "")">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
                    <span>Cá nhân</span>
                    @if (unread > 0) { <span class="personal-unread-dot" aria-hidden="true"></span> }
                </button>
            }
            else
            {
                <a class="btn btn-primary site-login" asp-area="" asp-controller="Account" asp-action="Login">Đăng nhập</a>
            }
        </div>
    </header>
    @if (signedIn)
    {
        <partial name="_PersonalMenu" model="unread" />
    }
    <main id="main-content" tabindex="-1">
        @RenderBody()
    </main>
    <footer class="site-footer mt-auto">
        <div class="container py-5">
            <div class="row g-4">
                <div class="col-lg-6"><p class="footer-brand">VinhUni Clubs</p><p class="mb-2">Kết nối đam mê. Cùng nhau trưởng thành.</p><p class="footer-note mb-0">Trường Đại học Vinh · 182 Lê Duẩn,<br />Phường Trường Vinh, Tỉnh Nghệ An.</p></div>
                <div class="col-sm-6 col-lg-3"><h2 class="h6">KHÁM PHÁ</h2><a asp-area="" asp-controller="Clubs" asp-action="Index">Danh mục câu lạc bộ</a><a asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="doi-song">Đời sống sinh viên</a><a asp-area="" asp-controller="Account" asp-action="Login">Không gian của bạn</a></div>
                <div class="col-sm-6 col-lg-3"><h2 class="h6">KẾT NỐI VỚI TRƯỜNG</h2><a href="https://vinhuni.edu.vn/pages/" target="_blank" rel="noopener noreferrer">Cổng thông tin Đại học Vinh ↗</a><a href="https://hoisinhvien.vinhuni.edu.vn/" target="_blank" rel="noopener noreferrer">Hội Sinh viên Trường ↗</a></div>
            </div>
            <div class="footer-bottom">Đồ án học phần Công nghệ phần mềm. Hình ảnh và nội dung tham khảo: Cổng TT Đại học Vinh. Đây không phải website chính thức của trường.</div>
        </div>
    </footer>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
