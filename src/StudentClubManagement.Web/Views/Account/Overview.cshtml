@model StudentClubManagement.Web.ViewModels.Account.AccountOverviewViewModel
@{
    ViewData["Title"] = "Tài khoản của tôi";
}
<section class="container py-5">
    <p class="eyebrow">Không gian cá nhân</p>
    <h1 class="h2 mb-4">Tài khoản của tôi</h1>
    @if (TempData["StatusMessage"] is string message)
    {
        <div class="alert alert-success account-details" role="status">@message</div>
    }
    <div class="card community-card account-details">
        <div class="card-body p-4 p-md-5">
            <h2 class="h4 mb-4 text-break">@Model.FullName</h2>
            <dl class="row mb-0">
                <dt class="col-sm-4">Email</dt>
                <dd class="col-sm-8 text-break">@Model.Email</dd>
                @if (Model.StudentCode is not null)
                {
                    <dt class="col-sm-4">Mã sinh viên</dt>
                    <dd class="col-sm-8 text-break">@Model.StudentCode</dd>
                }
                <dt class="col-sm-4">Quyền hệ thống</dt>
                <dd class="col-sm-8">@(Model.IsAdmin ? "Quản trị viên" : "Sinh viên")</dd>
                <dt class="col-sm-4">Số điện thoại</dt>
                <dd class="col-sm-8 text-break">@(Model.PhoneNumber ?? "Chưa cập nhật")</dd>
                <dt class="col-sm-4">Lớp</dt>
                <dd class="col-sm-8 text-break">@(Model.ClassName ?? "Chưa cập nhật")</dd>
                <dt class="col-sm-4">Khoa</dt>
                <dd class="col-sm-8 text-break">@(Model.Faculty ?? "Chưa cập nhật")</dd>
            </dl>
            <div class="d-flex flex-column flex-sm-row flex-wrap gap-3 mt-4">
                <a class="btn btn-primary" asp-area="" asp-controller="Account" asp-action="EditProfile">Chỉnh sửa hồ sơ</a>
                <a class="btn btn-outline-secondary" asp-area="" asp-controller="Account" asp-action="ChangePassword">Đổi mật khẩu</a>
                @if (!Model.IsAdmin && User.IsInRole(StudentClubManagement.Web.Security.SystemRoles.Student))
                {
                    <a class="btn btn-outline-primary" asp-area="" asp-controller="Memberships" asp-action="Mine">CLB của tôi</a>
                    <a class="btn btn-outline-primary" asp-area="" asp-controller="EventRegistrations" asp-action="Mine">Hoạt động đã đăng ký</a>
                    <a class="btn btn-outline-primary" asp-area="" asp-controller="Announcements" asp-action="Mine">Thông báo của tôi</a>
                }
                @if (Model.IsAdmin)
                {
                    <a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Vào khu vực quản trị</a>
                }
            </div>
        </div>
    </div>
</section>
