@model StudentClubManagement.Web.ViewModels.Account.StudentRegistrationForm
@{ ViewData["Title"] = "Đăng ký tài khoản sinh viên"; }
<section class="container py-5"><div class="account-details mx-auto"><p class="eyebrow">Gia nhập cộng đồng</p><h1 class="h2">Đăng ký tài khoản sinh viên</h1>
<div class="card community-card p-4 p-md-5 mt-4"><p>Tự điền thông tin và đặt mật khẩu. Admin sẽ kiểm tra hồ sơ; bạn chỉ có thể đăng nhập sau khi được duyệt.</p>
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<form asp-action="Register" method="post">
    <div class="mb-3"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" autocomplete="name" /></div>
    <div class="mb-3"><label asp-for="StudentCode" class="form-label"></label><input asp-for="StudentCode" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autocomplete="email" /></div>
    <div class="row g-3 mb-3"><div class="col-md-6"><label asp-for="ClassName" class="form-label"></label><input asp-for="ClassName" class="form-control" /></div><div class="col-md-6"><label asp-for="Faculty" class="form-label"></label><input asp-for="Faculty" class="form-control" /></div></div>
    <div class="mb-3"><label asp-for="Password" class="form-label">Mật khẩu</label><input asp-for="Password" class="form-control" autocomplete="new-password" /><small class="text-secondary">Tối thiểu 10 ký tự, gồm chữ hoa, chữ thường, số và ký tự đặc biệt.</small></div>
    <div class="mb-3"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /></div>
    <button class="btn btn-primary" type="submit">Gửi đăng ký</button><a class="btn btn-link" asp-action="Login">Đã có tài khoản? Đăng nhập</a>
</form></div></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

