@model StudentClubManagement.Web.ViewModels.Account.ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}
<section class="container py-5">
    <div class="account-details mx-auto">
        <a class="d-inline-block mb-4" asp-area="" asp-controller="Account" asp-action="Overview">← Tài khoản của tôi</a>
        <p class="eyebrow">Bảo vệ tài khoản</p>
        <h1 class="h2 mb-3">Đổi mật khẩu</h1>
        <p class="text-secondary mb-4">Sau khi đổi thành công, bạn tiếp tục sử dụng thiết bị này. Các thiết bị khác cần đăng nhập lại.</p>
        <div class="card community-card">
            <div class="card-body p-4 p-md-5">
                <form asp-area="" asp-controller="Account" asp-action="ChangePassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger validation-summary" role="alert"></div>
                    <div class="mb-4">
                        <label asp-for="CurrentPassword" class="form-label fw-semibold"></label>
                        <input asp-for="CurrentPassword" class="form-control form-control-lg" autocomplete="current-password" aria-describedby="current-password-error" />
                        <span asp-validation-for="CurrentPassword" class="text-danger small" id="current-password-error"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="NewPassword" class="form-label fw-semibold"></label>
                        <input asp-for="NewPassword" class="form-control form-control-lg" autocomplete="new-password" aria-describedby="password-guidance new-password-error" />
                        <p class="form-text mb-1" id="password-guidance">Ít nhất 10 ký tự, có chữ hoa, chữ thường, chữ số và ký tự đặc biệt. Chọn mật khẩu khác mật khẩu hiện tại.</p>
                        <span asp-validation-for="NewPassword" class="text-danger small" id="new-password-error"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                        <input asp-for="ConfirmPassword" class="form-control form-control-lg" autocomplete="new-password" aria-describedby="confirm-password-error" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small" id="confirm-password-error"></span>
                    </div>
                    <div class="d-flex flex-column flex-sm-row gap-3">
                        <button class="btn btn-primary px-4 py-2" type="submit">Lưu mật khẩu mới</button>
                        <a class="btn btn-outline-secondary px-4 py-2" asp-area="" asp-controller="Account" asp-action="Overview">Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
